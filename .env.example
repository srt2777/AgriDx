# Server Port & Environment
PORT=3000
NODE_ENV=development

# Monitoring is backend simulation only; off disables both read endpoints. No device ingest.
TELEMETRY_MODE=simulated
# Optional deterministic unsigned 32-bit seed (default 2777).
TELEMETRY_SEED=2777

# LLM Providers (Server-side only)
# auto 保留已有 Gemini 优先策略；可指定 deepseek 或 gemini，失败后仍回退另一家已配置的模型。
# 配置状态仅代表 Key 非空，是否可用由真实请求验证。两家 Key 为空时使用本地知识库。
LLM_PROVIDER=auto
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
# 可指定 OpenAI 兼容服务根路径；会追加 /chat/completions。
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Optional Network Proxy
HTTPS_PROXY=
HTTP_PROXY=

# 回答协调（与LLM_PROVIDER供应商选择是不同配置）
# auto：保守自动选择；knowledge_only：全站仅本地；ai_assisted：优先AI整理。
DIAGNOSIS_MODE=auto
# false可强制禁止一切外部模型请求；前端选择不能绕过。无效值也退回本地。
ALLOW_EXTERNAL_AI=true

# One main retrieval; these scores are raw keyword overlaps, never percentages or accuracy.
DIAGNOSIS_TOP_K=5
DIAGNOSIS_RAW_HIGH_THRESHOLD=8
DIAGNOSIS_RAW_MEDIUM_THRESHOLD=3
# Full source/limitations/body blocks share this character budget; no partial evidence truncation.
DIAGNOSIS_CONTEXT_MAX_CHARS=8000
# Static public knowledge retrieval only; bounded 30-second cache clears on knowledge reload.
# Routing logs omit raw questions/history/identifiers/credentials; disable if handled elsewhere.
DIAGNOSIS_LOG_DECISIONS=true

# Diagnostic memory (Node server only). Use an absolute path on a persistent disk.
# Restarting with the same file preserves records; do not commit or replace it on deploy.
# MEMORY_DB_PATH=/var/lib/agridx/memory.sqlite

# Optional private img2threejs worker. These are server-only; never prefix with VITE_.
# Install/validate the isolated worker first: docs/integrations/img2threejs.md
# IMG2THREEJS_SERVICE_URL=http://127.0.0.1:3011
# IMG2THREEJS_SERVICE_TOKEN=generate-a-random-secret-of-at-least-32-characters
