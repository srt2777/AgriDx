// 司稼小机器人 RV0.1.0 — 配网模板
// 使用方法：复制本文件为 secrets.h，填入自己的 WiFi 名称和密码。
// secrets.h 不要提交到 GitHub（.gitignore 已排除；公开仓库不要放密码）。
// 校园网有 captive portal（网页认证）时连不上，用手机热点。
#pragma once
#define WIFI_SSID "你的WiFi名称"
#define WIFI_PASSWORD "你的WiFi密码"
// 第二组 WiFi（新增，优先连）：有两个 WiFi 时填这里，固件先连第二组，
// 连不上再回落第一组；只有一个 WiFi 时留空/留占位符即可（不会写入 NVS）。
// 注意：secrets.h 里的第二组一旦写入 NVS，之后只读 NVS，改第二组要整片擦除重烧（同第一组）。
#define WIFI_SSID_2 "你的第二个WiFi名称"
#define WIFI_PASS_2 "你的第二个WiFi密码"
// 正式站地址（不要改）：机器人调正式站的 /api/chat 与 /api/telemetry/*。
// 单片机不发 Origin 头，符合正式站同源策略；不要在请求里加 Origin。
#define SIJIA_BASE_URL "https://agridx.xyz"
